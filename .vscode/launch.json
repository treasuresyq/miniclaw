{
  // 调试配置 — F5 启动。Miniclaw 三套入口：后端 Hono / Web Vite / Electron 主进程
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (tsx watch)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "env": {
        "NODE_ENV": "development",
        "TS_NODE_TRANSPILE_ONLY": "1"
      },
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Backend: reset admin",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "reset:admin"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Web (Vite dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web",
      "server": {
        "type": "node",
        "cwd": "${workspaceFolder}/web",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "dev:web"],
        "options": { "env": { "NODE_ENV": "development" } },
        "port": 5173,
        "restart": true
      },
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/*": "${webRoot}/*"
      }
    },
    {
      "name": "Electron main",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "args": ["."],
      "cwd": "${workspaceFolder}/electron",
      "outputCapture": "std",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Vitest current file",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/vitest",
      "args": ["run", "${file}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Vitest watch",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/vitest",
      "args": ["watch"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (backend + web)",
      "configurations": ["Backend (tsx watch)", "Web (Vite dev)"],
      "stopAll": true
    }
  ]
}
